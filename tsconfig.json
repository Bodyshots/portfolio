{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rootDir": "./",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {},
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": ["src", "vite-env.d.ts"],
  "types": ["node"]
}
